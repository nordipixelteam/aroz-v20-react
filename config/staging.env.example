# Configuration template only. Keep actual values in deployment secrets or ignored .env.staging.local.
# Vercel supplies NODE_ENV=production for Preview builds; do not set NODE_ENV=staging.
AVAULT_ENV=staging
MONGODB_DB=avault_staging
MONGODB_URI=
AVAULT_ENCRYPTION_KEY=
NEXT_PUBLIC_SITE_URL=
AVAULT_SCHEDULER=off
# Required only for approved external maintenance calls; use an independent random secret.
AVAULT_JOBS_SECRET=
