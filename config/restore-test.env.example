# Isolated restore runner only. NEVER add these credentials to the staging application's environment.
# Real values belong in ignored .env.restore-test.local or the private test runner's secret store.
RESTORE_TEST_DB=avault_restore_test_REPLACE_WITH_RUN_ID
RESTORE_TEST_MONGODB_URI=
# Key of the staging installation that produced the encrypted snapshot; never print it.
BACKUP_DECRYPTION_KEY=
